# ── SignalStack / Delphi Agent Arena ─────────────────────────────────────────
# Create this file yourself. Do not commit secrets.
# Testnet API key: https://delphi-api-access.gensyn.ai/

DELPHI_NETWORK=testnet
DELPHI_API_ACCESS_KEY=

# Registered competition wallet (public). Must match the signing wallet below.
SIGNALSTACK_WALLET=0x67df2320690a7870c20105662d525a567254b7d5

# Prefer dry-run until markets open (Aug 10). Set to 0 to send live trades.
SIGNALSTACK_DRY_RUN=1

# Competition trading window end (UTC). Prefer markets settling before this.
SIGNALSTACK_DEADLINE=2026-08-24T23:59:59.000Z

# Edge floor after slippage (absolute probability points, e.g. 0.06 = 6%).
SIGNALSTACK_MIN_EDGE=0.06

# Max fraction of bankroll per trade (Kelly fraction of bankroll).
SIGNALSTACK_MAX_BET_FRACTION=0.12

# Max actionable buys/sells per cycle (diversify, don't dump bankroll).
SIGNALSTACK_MAX_TRADES_PER_CYCLE=3

# Loop interval seconds for `npm run watch`
SIGNALSTACK_POLL_SECONDS=90

# ── Signer (pick ONE) ────────────────────────────────────────────────────────
DELPHI_SIGNER_TYPE=private_key
WALLET_PRIVATE_KEY=

# Or CDP Server Wallet:
# DELPHI_SIGNER_TYPE=cdp_server_wallet
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
# CDP_WALLET_ADDRESS=

# ── Optional LLM calibration (OpenAI-compatible) ─────────────────────────────
# Leave unset to skip LLM signal (external odds + anti-herd still run).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# ── Optional Polymarket gamma API override ───────────────────────────────────
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
